rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Exchange rates — any signed-in user can read; only backend writes
    match /exchangeRates/{corridorId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Per-user data — strictly scoped to the authenticated owner
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Contacts — owner can read and write
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Transfers — owner can read; writes are Cloud Functions only
      match /transfers/{transferId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
